{
  "manifest_version": 3,
  "name": "FormPilot - AI Form Assistant",
  "version": "1.0.0",
  "description": "AI-powered form guidance and autofill. Click to analyze any form and get field-by-field help.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://formpilot-api-93135657352.us-central1.run.app/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
